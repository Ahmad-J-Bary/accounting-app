# ─────────────────────────────────────────────────────────────────
# pnpm configuration – cross-platform (Linux / Windows)
# ─────────────────────────────────────────────────────────────────
# node-linker=hoisted: avoids symlink/junction issues on Windows
# when Developer Mode is disabled or permissions are restricted.
# On Linux this behaves identically to the default 'isolated' linker
# but is more compatible across filesystems (e.g. WSL, Docker).
# ─────────────────────────────────────────────────────────────────
node-linker=hoisted

# ── Strict mode: require frozen lockfile in CI ──────────────────
frozen-lockfile=false

# ── Use exact versions (no ^ / ~) for workspace dependencies ────
save-workspace-protocol=exact
